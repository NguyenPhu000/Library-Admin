# ==============================================================================
# Library Admin - Environment Configuration Template
# ==============================================================================

# Base URL của Library Admin REST API (theo API Contract: docs/api-contract.md)
# - Chạy cục bộ với Fastify backend: http://localhost:3000/api/v1
# - Chạy qua đường hầm ngrok: https://<subdomain>.ngrok-free.app/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Bật/tắt Mock Service Worker (MSW) khi chạy môi trường dev (true | false)
# - Đặt 'true' để dùng mock data khi chưa có backend thật
# - Đặt 'false' khi tích hợp với API thật của backend qua ngrok/localhost
VITE_ENABLE_MSW=true
